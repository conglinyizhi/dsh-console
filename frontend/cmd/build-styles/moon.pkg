import {
  "conglinyizhi/precss",
  "conglinyizhi/precss/core",
  // 根包本身没有直接调用点，但 `async fn main` 需要它在场：
  // 少了它就报「Cannot use `async fn main`: package moonbitlang/async is not imported」。
  "moonbitlang/async",
  "moonbitlang/async/fs",
}

// 样式编译是构建期的一步，跑在 native 上（读文件、写产物）。

supported_targets = "native"

pkgtype(kind: "executable")
