import {
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/http",
  // 端口探测要拿 @js.Promise（@cmd.attempt 的 async 体里 wait 它），
  // 其余浏览器副作用走 dom.mbt 里的 extern "js"，不引 rabbita/dom 整包。
  "moonbit-community/rabbita/js",
  // 图标是内联 SVG（icons.mbt）：@svg 的 node 走 createElementNS，
  // @html 那套建出来的 <svg> 不在 SVG 命名空间里，不会渲染。
  "moonbit-community/rabbita/svg",
  "moonbitlang/core/json",
}

// 整包只出 js 产物：`theme.mbt` 里有一处 extern "js"（取浏览器本地时刻），
// native 目标编不过。这是有意的 —— 前端这一侧的运行期就是浏览器。

supported_targets = "js"
